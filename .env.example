# Postgres (Neon ou Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/fiscalenergia?schema=public"

# Auth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (storage do arquivo original da fatura)
BLOB_READ_WRITE_TOKEN=""

# API da Anthropic (extração de dados da fatura)
ANTHROPIC_API_KEY=""

# Resend (e-mail transacional). Sem RESEND_API_KEY, os e-mails são apenas
# logados no console (útil em dev/test) em vez de enviados de verdade.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Fiscalenergia <notificacoes@fiscalenergia.app>"
