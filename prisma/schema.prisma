generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TariffGroup {
  A
  B
}

enum BillStatus {
  pending
  processing
  done
  error
}

enum TariffFlag {
  verde
  amarela
  vermelha_p1
  vermelha_p2
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  companies     Company[]
  consumerUnits ConsumerUnit[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumerUnits ConsumerUnit[]
}

model ConsumerUnit {
  id                 String      @id @default(cuid())
  ownerId            String
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  code               String
  distributor        String
  uf                 String
  city               String
  tariffGroup        TariffGroup
  tariffSubgroup     String
  tariffModality     String
  contractedDemandKw Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bills Bill[]

  @@unique([ownerId, code])
}

model Bill {
  id             String       @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  referenceMonth DateTime
  fileUrl        String
  status         BillStatus   @default(pending)
  createdAt      DateTime     @default(now())

  // Preenchidos pela extração da Fase 3 (lib/claude.ts); nulos até o
  // processamento terminar, e campos individuais continuam nulos quando o
  // Claude não teve confiança para extrair aquele valor.
  totalAmount        Float?
  consumptionKwh     Float?
  tariffFlag         TariffFlag?
  previousReadingKwh Float?
  currentReadingKwh  Float?
  billingDays        Int?
  appliedKwhRate     Float?
  lineItems          Json?
  extractedData      Json?
  errorMessage       String?

  @@index([consumerUnitId])
}
