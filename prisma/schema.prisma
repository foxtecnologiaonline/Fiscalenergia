generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TariffGroup {
  A
  B
}

enum BillStatus {
  pending
  processing
  done
  error
}

enum TariffFlag {
  verde
  amarela
  vermelha_p1
  vermelha_p2
}

enum FindingType {
  billing_error
  reading_error
  appliance_inefficiency
  possible_waste_or_loss
  consumption_anomaly
  top_consumer
}

enum FindingSeverity {
  low
  medium
  high
}

// Cômodos padrão do questionário de varredura (ver docs/SCOPE.md). Fixo no
// ApplianceCatalog (conteúdo mantido por nós); HouseholdAppliance usa String
// livre para "room" para permitir instâncias repetidas (ex.: "Quarto 1",
// "Quarto 2") quando a casa tem mais de um cômodo do mesmo tipo.
enum Room {
  cozinha
  sala
  quarto
  banheiro
  area_servico
  escritorio
  area_externa
}

enum ApplianceCondition {
  novo
  normal
  antigo
  sem_manutencao
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  companies     Company[]
  consumerUnits ConsumerUnit[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumerUnits ConsumerUnit[]
}

model ConsumerUnit {
  id                 String      @id @default(cuid())
  ownerId            String
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  code               String
  distributor        String
  uf                 String
  city               String
  tariffGroup        TariffGroup
  tariffSubgroup     String
  tariffModality     String
  contractedDemandKw Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bills               Bill[]
  findings            Finding[]
  householdAppliances HouseholdAppliance[]

  @@unique([ownerId, code])
}

model Bill {
  id             String       @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  referenceMonth DateTime
  fileUrl        String
  status         BillStatus   @default(pending)
  createdAt      DateTime     @default(now())

  // Preenchidos pela extração da Fase 3 (lib/claude.ts); nulos até o
  // processamento terminar, e campos individuais continuam nulos quando o
  // Claude não teve confiança para extrair aquele valor.
  totalAmount        Float?
  consumptionKwh     Float?
  tariffFlag         TariffFlag?
  previousReadingKwh Float?
  currentReadingKwh  Float?
  billingDays        Int?
  appliedKwhRate     Float?
  lineItems          Json?
  extractedData      Json?
  errorMessage       String?

  findings Finding[]

  @@index([consumerUnitId])
}

// Tarifa homologada (TE+TUSD) e alíquota de ICMS por distribuidora/UF/grupo/
// subgrupo, mantida manualmente no MVP (ver docs/SCOPE.md, seção 10).
model TariffReference {
  id             String      @id @default(cuid())
  distributor    String
  uf             String
  tariffGroup    TariffGroup
  tariffSubgroup String
  validFrom      DateTime
  validTo        DateTime?
  kwhRate        Float
  icmsRate       Float

  @@unique([distributor, uf, tariffGroup, tariffSubgroup, validFrom])
}

// Bandeira tarifária vigente por mês (dado público ANEEL), mantida
// manualmente no MVP (ver docs/SCOPE.md, seção 10).
model TariffFlagHistory {
  id             String     @id @default(cuid())
  referenceMonth DateTime   @unique
  flag           TariffFlag
}

model Finding {
  id                    String          @id @default(cuid())
  consumerUnitId        String
  consumerUnit          ConsumerUnit    @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  billId                String?
  bill                  Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  type                  FindingType
  ruleCode              String
  severity              FindingSeverity
  description           String
  estimatedImpactAmount Float?
  createdAt             DateTime        @default(now())

  @@index([consumerUnitId])
  @@index([billId])
}

// Catálogo de referência de aparelhos por cômodo, usado para pré-preencher o
// assistente de varredura (Fase 5). Conteúdo mantido manualmente via
// prisma/seed.ts — valores ILUSTRATIVOS, ver docs/SCOPE.md seção 10.
model ApplianceCatalog {
  id                      String @id @default(cuid())
  name                    String
  category                String
  room                    Room
  typicalPowerW           Float
  typicalUsageHoursPerDay Float
  typicalUsageDaysPerWeek Float
  referenceKwhMonth       Float?
  notes                   String?

  householdAppliances HouseholdAppliance[]

  @@unique([room, name])
}

model HouseholdAppliance {
  id             String            @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit      @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  catalogId      String?
  catalog        ApplianceCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  name              String
  room              String
  powerW            Float
  usageHoursPerDay  Float
  usageDaysPerWeek  Float
  quantity          Int                @default(1)
  ageYears          Float?
  lastMaintenanceAt DateTime?
  condition         ApplianceCondition @default(normal)
  isCustom          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([consumerUnitId])
}
