generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TariffGroup {
  A
  B
}

enum BillStatus {
  pending
  processing
  done
  error
}

enum TariffFlag {
  verde
  amarela
  vermelha_p1
  vermelha_p2
}

enum FindingType {
  billing_error
  reading_error
  appliance_inefficiency
  possible_waste_or_loss
  consumption_anomaly
  top_consumer
}

enum FindingSeverity {
  low
  medium
  high
}

// Cômodos padrão do questionário de varredura (ver docs/SCOPE.md). Fixo no
// ApplianceCatalog (conteúdo mantido por nós); HouseholdAppliance usa String
// livre para "room" para permitir instâncias repetidas (ex.: "Quarto 1",
// "Quarto 2") quando a casa tem mais de um cômodo do mesmo tipo.
enum Room {
  cozinha
  sala
  quarto
  banheiro
  area_servico
  escritorio
  area_externa
}

enum ApplianceCondition {
  novo
  normal
  antigo
  sem_manutencao
}

// "dismissed" é declarado agora para completar o modelo de dados da Fase 7
// (docs/IMPLEMENTATION_PLAN.md), mas nenhuma rota/UI usa esse valor ainda —
// mesmo padrão já usado nas Fases 4/6 para enums antecipados.
enum SuggestionStatus {
  suggested
  applied
  dismissed
}

// Só "email" existe no MVP (ver docs/IMPLEMENTATION_PLAN.md, Fase 9 —
// "Fora de escopo: canais além de e-mail"); enum mesmo assim, para manter
// o campo fechado e tipado quando push/SMS forem adicionados depois.
enum NotificationChannel {
  email
}

model User {
  id                        String   @id @default(cuid())
  email                     String   @unique
  name                      String?
  passwordHash              String
  emailNotificationsEnabled Boolean  @default(true)
  createdAt                 DateTime @default(now())

  companies     Company[]
  consumerUnits ConsumerUnit[]
  notifications Notification[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumerUnits ConsumerUnit[]
}

model ConsumerUnit {
  id                 String      @id @default(cuid())
  ownerId            String
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  code               String
  distributor        String
  uf                 String
  city               String
  tariffGroup        TariffGroup
  tariffSubgroup     String
  tariffModality     String
  contractedDemandKw Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bills               Bill[]
  findings            Finding[]
  householdAppliances HouseholdAppliance[]
  suggestions         Suggestion[]

  @@unique([ownerId, code])
}

model Bill {
  id             String       @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  referenceMonth DateTime
  fileUrl        String
  status         BillStatus   @default(pending)
  createdAt      DateTime     @default(now())

  // Preenchidos pela extração da Fase 3 (lib/claude.ts); nulos até o
  // processamento terminar, e campos individuais continuam nulos quando o
  // Claude não teve confiança para extrair aquele valor.
  totalAmount        Float?
  consumptionKwh     Float?
  tariffFlag         TariffFlag?
  previousReadingKwh Float?
  currentReadingKwh  Float?
  billingDays        Int?
  appliedKwhRate     Float?
  lineItems          Json?
  extractedData      Json?
  errorMessage       String?

  findings               Finding[]
  suggestionsAsBaseline  Suggestion[] @relation("SuggestionBaselineBill")
  suggestionsAsFollowUp  Suggestion[] @relation("SuggestionFollowUpBill")
  notifications          Notification[]

  @@index([consumerUnitId])
}

// Tarifa homologada (TE+TUSD) e alíquota de ICMS por distribuidora/UF/grupo/
// subgrupo, mantida manualmente no MVP (ver docs/SCOPE.md, seção 10).
model TariffReference {
  id             String      @id @default(cuid())
  distributor    String
  uf             String
  tariffGroup    TariffGroup
  tariffSubgroup String
  validFrom      DateTime
  validTo        DateTime?
  kwhRate        Float
  icmsRate       Float

  @@unique([distributor, uf, tariffGroup, tariffSubgroup, validFrom])
}

// Bandeira tarifária vigente por mês (dado público ANEEL), mantida
// manualmente no MVP (ver docs/SCOPE.md, seção 10).
model TariffFlagHistory {
  id             String     @id @default(cuid())
  referenceMonth DateTime   @unique
  flag           TariffFlag
}

model Finding {
  id                    String          @id @default(cuid())
  consumerUnitId        String
  consumerUnit          ConsumerUnit    @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  billId                String?
  bill                  Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  type                  FindingType
  ruleCode              String
  severity              FindingSeverity
  description           String
  estimatedImpactAmount Float?
  createdAt             DateTime        @default(now())

  suggestions Suggestion[]

  @@index([consumerUnitId])
  @@index([billId])
}

// Catálogo de referência de aparelhos por cômodo, usado para pré-preencher o
// assistente de varredura (Fase 5). Conteúdo mantido manualmente via
// prisma/seed.ts — valores ILUSTRATIVOS, ver docs/SCOPE.md seção 10.
model ApplianceCatalog {
  id                      String @id @default(cuid())
  name                    String
  category                String
  room                    Room
  typicalPowerW           Float
  typicalUsageHoursPerDay Float
  typicalUsageDaysPerWeek Float
  referenceKwhMonth       Float?
  notes                   String?

  householdAppliances HouseholdAppliance[]

  @@unique([room, name])
}

model HouseholdAppliance {
  id             String            @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit      @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)
  catalogId      String?
  catalog        ApplianceCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  name              String
  room              String
  powerW            Float
  usageHoursPerDay  Float
  usageDaysPerWeek  Float
  quantity          Int                @default(1)
  ageYears          Float?
  lastMaintenanceAt DateTime?
  condition         ApplianceCondition @default(normal)
  isCustom          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  suggestions Suggestion[]

  @@index([consumerUnitId])
}

// Sugestão de economia gerada a partir de um achado (Finding) de fatura,
// leitura, eficiência de aparelho ou possível desperdício (ver
// docs/SCOPE.md, seção 5.6). `findingId`/`householdApplianceId` usam
// onDelete: SetNull propositalmente: os achados derivados de aparelho
// (Fase 6) são recalculados do zero a cada mudança na varredura — perder o
// vínculo com o Finding antigo não deve apagar uma Suggestion que o
// usuário já marcou como aplicada. `@@unique([consumerUnitId, ruleCode,
// title])` é a chave usada por lib/rules/apply-suggestions.ts para
// atualizar (nunca duplicar) a mesma sugestão a cada novo ciclo de fatura.
model Suggestion {
  id             String       @id @default(cuid())
  consumerUnitId String
  consumerUnit   ConsumerUnit @relation(fields: [consumerUnitId], references: [id], onDelete: Cascade)

  findingId String?
  finding   Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  householdApplianceId String?
  householdAppliance   HouseholdAppliance? @relation(fields: [householdApplianceId], references: [id], onDelete: SetNull)

  ruleCode               String
  title                  String
  description            String
  estimatedSavingsKwh    Float?
  estimatedSavingsAmount Float?
  status                 SuggestionStatus @default(suggested)

  appliedAt   DateTime?
  appliedNote String?

  baselineBillId String?
  baselineBill   Bill? @relation("SuggestionBaselineBill", fields: [baselineBillId], references: [id], onDelete: SetNull)

  followUpBillId String?
  followUpBill   Bill? @relation("SuggestionFollowUpBill", fields: [followUpBillId], references: [id], onDelete: SetNull)

  actualSavingsKwh    Float?
  actualSavingsAmount Float?
  evaluatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerUnitId, ruleCode, title])
  @@index([consumerUnitId])
  @@index([findingId])
  @@index([householdApplianceId])
  @@index([baselineBillId])
  @@index([followUpBillId])
}

// Registro de e-mails enviados (Fase 9, docs/SCOPE.md seção 6, passo 10):
// processamento de fatura concluído, achado de severidade alta, e sugestão
// aplicada avaliada. billId fica nulo apenas se a fatura de origem for
// removida (não há rota de exclusão de fatura no MVP, mas SetNull evita
// que a remoção de uma fatura apague o histórico de notificações).
model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId    String?
  bill      Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  channel   NotificationChannel @default(email)
  message   String
  sentAt    DateTime            @default(now())

  @@index([userId])
  @@index([billId])
}
